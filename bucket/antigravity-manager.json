{
    "version": "4.9.6",
    "description": "Professional Antigravity Account Manager & Switcher. One-click seamless account switching for Antigravity Tools.",
    "homepage": "https://github.com/lbjlaq/Antigravity-Manager",
    "license": "CC-BY-NC-SA-4.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/lbjlaq/Antigravity-Manager/releases/download/v4.9.6/Antigravity.Tools_4.9.6_x64-setup.exe#/dl.7z",
            "hash": "03725cd33b910c559232b30e7fd64a9a2391c17346576232966205b470e96eaa"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninstall.exe\" -Force -Recurse -ErrorAction Ignore",
    "post_install": [
        "$config_dir = \"$env:USERPROFILE\\.antigravity_tools\"",
        "$config_file = \"$config_dir\\update_settings.json\"",
        "if (!(Test-Path $config_dir)) {",
        "    New-Item $config_dir -ItemType Directory -Force | Out-Null",
        "}",
        "if (Test-Path $config_file) {",
        "    $settings = (Get-Content $config_file -Raw | ConvertFrom-Json)",
        "    $settings.auto_check = $false",
        "    Set-Content $config_file ($settings | ConvertToPrettyJson) -Encoding ASCII -Force",
        "} else {",
        "    $settings = @{ 'auto_check' = $false }",
        "    Set-Content $config_file ($settings | ConvertToPrettyJson) -Encoding ASCII -Force",
        "}"
    ],
    "bin": [
        "antigravity-tools.exe",
        [
            "antigravity-tools.exe",
            "antigravity-manager"
        ]
    ],
    "shortcuts": [
        [
            "antigravity-tools.exe",
            "Antigravity Tools"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/lbjlaq/Antigravity-Manager/releases/download/v$version/Antigravity.Tools_$version_x64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$url.digest"
        }
    }
}
