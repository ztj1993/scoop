    "extract_dir": "gfw-pac-20261001.1",
    "post_install": [
        "$bucket_dir = Find-BucketDirectory -Root -Name $bucket",
        "if (Test-Path \"$bucket_dir\\scripts\\gfw-pac\") {",
        "    Copy-Item \"$bucket_dir\\scripts\\gfw-pac\\*\" \"$dir\" -Force",
        "}"
    ],
    "bin": [
        [
            "gfw-pac.cmd",
            "gfw-pac"
        ]
    ],
    "persist": [
        "gfw.pac",
        "direct-domains.txt",
        "proxy-domains.txt"
    ],
    "checkver": {
