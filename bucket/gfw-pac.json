    "notes": [
        "Run 'gfw-pac enable' to configure and turn on Windows PAC proxy (via file://).",
        "Run 'gfw-pac disable' to turn off Windows PAC proxy and restore direct connection.",
        "Run 'gfw-pac status' to check current Windows PAC status and proxy connectivity.",
        "Run 'gfw-pac config' to view or edit proxy settings in gfw.pac."
    ],
    "suggest": {
        "python": "python"
    },
