    "pre_install": [
        "$bucket_dir = Find-BucketDirectory -Root -Name $bucket",
        "if (Test-Path \"$bucket_dir\\scripts\\antigravity-proxy\") {",
        "    Copy-Item \"$bucket_dir\\scripts\\antigravity-proxy\\*\" \"$dir\" -Force",
        "}",
        "'ide', 'cli' | ForEach-Object {",
        "    if (Test-Path \"$persist_dir\\$_\\config.json\" -PathType Container) {",
        "        Remove-Item \"$persist_dir\\$_\\config.json\" -Recurse -Force",
        "    }",
        "}"
    ],
    "bin": [
        [
            "antigravity-proxy.cmd",
            "antigravity-proxy"
        ]
    ],
    "persist": [
        "ide\\config.json",
        "cli\\config.json"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/yuaotian/antigravity-proxy/releases/download/v$version/antigravity-proxy-v$version-ide-win-x64.zip",
                    "https://github.com/yuaotian/antigravity-proxy/releases/download/v$version/antigravity-proxy-v$version-cli-win-x64.zip"
                ]
