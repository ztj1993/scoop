{
    "version": "2.6",
    "description": "Transparent proxy injector for Antigravity, forcing SOCKS5/HTTP proxy without TUN mode on Windows.",
    "homepage": "https://github.com/yuaotian/antigravity-proxy",
    "license": {
        "identifier": "BSD-2-Clause",
        "url": "https://github.com/yuaotian/antigravity-proxy/blob/main/LICENSE.txt"
    },
    "notes": [
        "Run 'antigravity-proxy ide apply' to deploy proxy injector & apply config to Antigravity IDE.",
        "Run 'antigravity-proxy cli apply' to deploy proxy injector & apply config to Antigravity CLI.",
        "Run 'antigravity-proxy ide uninstall' to remove proxy injector from Antigravity IDE.",
        "Run 'antigravity-proxy cli uninstall' to remove proxy injector from Antigravity CLI.",
        "Run 'antigravity-proxy ide config -ProxyPort <port>' to configure IDE proxy settings.",
        "Run 'antigravity-proxy cli config -ProxyPort <port>' to configure CLI proxy settings.",
        "Run 'antigravity-proxy web' to open visual configuration console in browser."
    ],
    "suggest": {
        "antigravity": "antigravity",
        "vcredist": "vcredist-aio"
    },
