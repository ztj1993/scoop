            ],
            "hash": [
                "921786c4abb49f81059cba92e5682adedcff2c975128158628695f344e137c45",
                "4e01fb0181ff2bcebeee8f1482aa5b55b97ed33bb7d013e692ffa26d94c7aa85"
            ]
        },
        "32bit": {
